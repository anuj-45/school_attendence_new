# Example environment variables for local development / deployment
# Copy to .env and fill values (do NOT commit secrets)

# Application
PORT=4000
CLIENT_URL=http://localhost:3000

# JWT secret used to sign auth tokens (required)
JWT_SECRET=replace_with_a_long_random_secret

# Database (Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_attendance
DB_USER=postgres
DB_PASSWORD=postgres

# Optional
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin12345
SCHOOL_ADMIN_CODE=11111111111
